#!/bin/sh /etc/rc.common
#
# WakeMyPc init script (procd)
# Copyright (c) 2026 WakeMyPc contributors
# License: MIT
#

START=99
USE_PROCD=1

PROG=/usr/bin/wakemypc

start_service() {
	local enabled

	enabled=$(uci -q get wakemypc.bot.enabled)

	if [ "$enabled" != "1" ]; then
		logger -t wakemypc "not started: disabled in /etc/config/wakemypc"
		return 0
	fi

	if [ ! -x "$PROG" ]; then
		logger -t wakemypc "not started: $PROG is missing"
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	# The bot can be blocked in a long-poll request, so do not wait long on stop.
	procd_set_param term_timeout 2
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param nice 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "wakemypc"
}

reload_service() {
	stop
	start
}
